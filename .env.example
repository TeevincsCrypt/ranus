# ─────────────────────────────────────────────────────────────────────────────
# RANUS configuration — copy to `.env` (repo root) for local development.
# On Vercel, set the same variables in Project → Settings → Environment Variables.
# Never commit your real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Amazon Bedrock (required for the chat agent) ─────────────────────────────
# Region with Claude in Amazon Bedrock (Messages API endpoint
# https://bedrock-mantle.{region}.api.aws/anthropic). Takes precedence over
# AWS_REGION, which Vercel presets to the function's own region.
BEDROCK_AWS_REGION=us-east-1

# Pick ONE way to authenticate (checked in this order):
#  (a) A Bedrock API key / bearer token (simplest; works locally and on Vercel):
# AWS_BEARER_TOKEN_BEDROCK=
#  (b) Vercel OIDC federation → an IAM role allowed `bedrock-mantle:CreateInference`
#      (Vercel deployments only; no stored AWS keys):
# RANUS_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/ranus-bedrock
#  (c) IAM keys under RANUS names (works everywhere, including Vercel, which presets
#      the standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY names with unusable values):
# RANUS_AWS_ACCESS_KEY_ID=
# RANUS_AWS_SECRET_ACCESS_KEY=
# RANUS_AWS_SESSION_TOKEN=
#  (d) Local only: standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, or SSO.

# Claude model on Bedrock. Claude Opus 5.5 is the default; if your account
# doesn't have access to it yet, use anthropic.claude-opus-4-8 (open to all
# Bedrock customers) — no code changes needed.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Client-side refusal fallback model ("none" disables it).
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8
# Reasoning effort: low | medium | high | xhigh | max
RANUS_EFFORT=medium
# Max model↔tool round trips per question.
RANUS_MAX_STEPS=10
# Max output tokens per model call (thinking + answer). Bedrock reserves input + this
# value against your tokens-per-minute quota at the start of each call; on a small
# quota (e.g. 20,000 TPM) use 4000 together with RANUS_EFFORT=low.
RANUS_MAX_TOKENS=16000

# ── Live data sources (all work without keys; keys raise rate limits) ────────
# Solana mainnet RPC. The public endpoint works but is rate-limited; a free
# Helius/Triton/QuickNode URL is recommended for demos.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter (prices, token metadata, tokenized stocks, swap quotes).
# Keyless access on api.jup.ag is 0.5 requests/second; a free key from
# https://developers.jup.ag/portal raises it to 1 RPS (paid tiers more).
JUPITER_API_BASE=https://api.jup.ag
# JUPITER_API_KEY=

# DefiLlama yields (USDY, liquid staking, cross-protocol stablecoin yields). No key.
DEFILLAMA_YIELDS_URL=https://yields.llama.fi/pools

# Kamino Lend market to read (default: main market).
KAMINO_MARKET=7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF

# ── Access control (recommended for public deployments) ──────────────────────
# When set, chatting (which spends Bedrock quota) requires this code; the UI asks once.
# RANUS_ACCESS_CODE=
# Require `Authorization: Bearer <token>` on the public MCP endpoint (/mcp).
# RANUS_MCP_TOKEN=

# ── RANUS MCP server ─────────────────────────────────────────────────────────
# The web app serves the MCP server at /mcp and its agent uses it in-process.
# Set RANUS_MCP_URL to make the agent use a remote MCP server over HTTP instead
# (also the target of `npm run smoke`, default http://localhost:3000/mcp).
# RANUS_MCP_URL=https://your-app.vercel.app/mcp
# Standalone server (`npm run mcp:standalone`) bind address:
RANUS_MCP_HOST=127.0.0.1
RANUS_MCP_PORT=8787
